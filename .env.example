# Ulysses reads secrets from the environment, not YAML.
OPENAI_API_KEY=

# Telegram connector bot token. Configure through `/setup connectors`.
# TELEGRAM_BOT_TOKEN=

# Kimi / Moonshot OpenAI-compatible API.
# KIMI_API_KEY=

# Local Ollama OpenAI-compatible API. No real key is needed by default.
# OLLAMA_API_KEY=ollama

# OpenAI browser login is configured interactively with `/setup providers`.
# Codex owns the OAuth credentials; no browser token belongs in this file.
# The installer discovers Codex with `command -v` and records ULYSSES_CODEX_BIN when available.

# Useful local overrides.
# ULYSSES__LLM__PROVIDER=mock
# SIRINA_MODEL_DIR=/absolute/path/to/models
