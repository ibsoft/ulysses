# Ulysses reads secrets from the environment, not YAML.
OPENAI_API_KEY=

# Optional OpenAI-compatible OAuth/provider token.
# ULYSSES__LLM__PROVIDER=oauth_compatible
# ULYSSES__LLM__BASE_URL=https://provider.example/v1
# ULYSSES__LLM__OAUTH_TOKEN_ENV=ULYSSES_PROVIDER_TOKEN
# ULYSSES_PROVIDER_TOKEN=

# Useful local overrides.
# ULYSSES__LLM__PROVIDER=mock
# SIRINA_MODEL_DIR=/absolute/path/to/models
